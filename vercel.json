{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "VITE_API_BASE_URL=/api npm run build",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://tradetrack-backend-frankfurt-fxf1.onrender.com/api/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
